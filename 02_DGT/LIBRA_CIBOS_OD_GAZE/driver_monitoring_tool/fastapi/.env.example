# Configuration for the backend application of driver-gaze demo. Copy to .env and edit.

# Set true on non-Jetson dev machines — random gaze, no camera or TensorRT.
SIMULATION_MODE=true
# Simulator emits only invalid points (none | nan | inf | zero) to test the invalid-data status.
SIMULATION_FAULT=none

# Written by the calibration flow;
CALIBRATION_MATRIX_PATH=calibration.pkl

# Rosbridge — replace localhost with the IP/hostname of the machine running rosbridge.
ROSBRIDGE_URL=ws://localhost:9090
ROS_TOPIC=/dgt/gaze/raw
ROS_MESSAGE_TYPE=geometry_msgs/PointStamped
ROS_CALIBRATION_TOPIC=/dgt/calibration_matrix
ROS_CALIBRATION_MESSAGE_TYPE=std_msgs/Float64MultiArray
ROS_RECONNECT_DELAY=3
PUBLISH_IN_SIMULATION=false

# Server
HOST=0.0.0.0
PORT=8000
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO