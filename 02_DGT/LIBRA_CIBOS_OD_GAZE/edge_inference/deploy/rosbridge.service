# rosbridge websocket server: relays /dgt/status (and any other topic on this
# ROS domain) to ws://<jetson-ip>:9090.
# Install:  sudo cp deploy/rosbridge.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now rosbridge
# The websocket binds 0.0.0.0:9090 — clients connect to ws://<jetson-ip>:9090.
# ROS_DOMAIN_ID and ROS_LOCALHOST_ONLY must match deploy/dgt.service.
[Unit]
Description=rosbridge websocket server (ROS 2 Humble)
After=network.target

[Service]
User=jetson
Environment=ROS_DOMAIN_ID=0
Environment=ROS_LOCALHOST_ONLY=1
ExecStart=/bin/bash -lc 'source /opt/ros/humble/setup.bash && ros2 launch rosbridge_server rosbridge_websocket_launch.xml port:=9090'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
