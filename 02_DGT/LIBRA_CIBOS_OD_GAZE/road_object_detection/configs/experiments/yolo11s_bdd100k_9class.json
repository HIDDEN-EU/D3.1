{
  "meta": {
    "name": "yolo11s-bdd100k-9class",
    "description": "YOLO11s fine-tuned on the 9-class BDD100K variant (random crops, rare-class guaranteed crops, background cap 0.15)."
  },
  "model": {
    "weights": "yolo11s.pt",
    "imgsz": 640
  },
  "dataset": {
    "data_yaml": "data/bdd100k_variant_9class/data.yaml",
    "val_test_ratio": 0.3,
    "split_seed": 42
  },
  "hyperparameters": {
    "epochs": 20,
    "batch_size": 32,
    "learning_rate": 0.01,
    "patience": 20,
    "optimizer": "SGD",
    "lrf": 0.01,
    "momentum": 0.937,
    "weight_decay": 0.0005,
    "warmup_epochs": 5.0,
    "cos_lr": false,
    "rect": false,
    "compile": true,
    "close_mosaic": 2,
    "seed": 42
  },
  "hardware": {
    "device": 0,
    "workers": 8
  },
  "mlflow": {
    "experiment_name": "road_object_detection",
    "tags": {
      "guarantee_classes": "rider,motorcycle,bicycle",
      "max_background_ratio": "0.15"
    }
  },
  "project_dir": "runs/train"
}
